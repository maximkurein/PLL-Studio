{
  "name": "pll-studio",
  "private": true,
  "version": "0.1.1",
  "description": "PLL Studio — interactive lab for the IDT/Renesas 8V97051 wideband RF synthesizer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "server": "cargo run --release -p pll-server --",
    "web": "vite build && cargo run --release -p pll-server",
    "test": "cargo test -p pll-core"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "author": "Kurein M N",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximkurein/PLL-Studio.git"
  }
}
